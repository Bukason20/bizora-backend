{
  "kind": "collectionType",
  "collectionName": "templates",
  "info": {
    "singularName": "template",
    "pluralName": "templates",
    "displayName": "template"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "niche": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "fashion",
        "real-estate",
        "food",
        "logistics",
        "beauty",
        "education",
        "services"
      ]
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "tags": {
      "type": "json"
    },
    "projects": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project.project",
      "mappedBy": "template"
    }
  }
}
